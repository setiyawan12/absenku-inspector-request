{
  "name": "absenku-net",
  "version": "1.1.0",
  "description": "Absenku Net — HTTP tunnel & request inspector via Cloudflare",
  "author": { "name": "Absenku", "email": "noreply@absenku.app" },
  "main": "electron/main.js",
  "bin": {
    "absenku": "./bin/absenku.js"
  },
  "scripts": {
    "start"     : "node server.js",
    "client"    : "node client.js",
    "dev"       : "node bin/absenku.js http 8000",
    "electron"  : "electron .",
    "build"     : "electron-builder --dir",
    "build:mac" : "electron-builder --mac",
    "build:win" : "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId"          : "com.absenku.net",
    "productName"    : "Absenku Net",
    "copyright"      : "Copyright © 2026 Absenku",
    "directories"    : { "output": "dist" },
    "files"          : [
      "electron/**/*",
      "lib/**/*",
      "bin/**/*",
      "package.json"
    ],
    "extraResources" : [
      { "from": "cloudflared", "to": "cloudflared" }
    ],
    "mac": {
      "icon"             : "electron/icon.png",
      "category"         : "public.app-category.developer-tools",
      "hardenedRuntime"  : false,
      "gatekeeperAssess" : false,
      "target"           : [{ "target": "dmg", "arch": ["arm64"] }]
    },
    "win": {
      "icon"  : "electron/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "linux": {
      "icon"    : "electron/icon.png",
      "category": "Development",
      "target"  : [
        { "target": "deb",      "arch": ["x64"] },
        { "target": "AppImage", "arch": ["x64"] }
      ]
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron"        : "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
