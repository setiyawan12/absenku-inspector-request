{
  "name": "wan-net",
  "version": "1.5.5",
  "description": "WAN NET — HTTP tunnel & request inspector via Cloudflare",
  "author": {
    "name": "WAN NET",
    "email": "noreply@wan-net.app"
  },
  "main": "electron/main.js",
  "bin": {
    "wan-net": "./bin/wan-net.js"
  },
  "scripts": {
    "start": "node server.js",
    "client": "node client.js",
    "dev": "node bin/wan-net.js http 8000",
    "electron": "electron .",
    "build": "electron-builder --dir",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.wan-net.app",
    "productName": "WAN-NET",
    "copyright": "Copyright © 2026 WAN NET",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "bin/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "cloudflared",
        "to": "cloudflared"
      }
    ],
    "mac": {
      "icon": "electron/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "entitlements": "scripts/entitlements.mac.plist",
      "entitlementsInherit": "scripts/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "icon": "electron/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "electron/icon.png",
      "category": "Development",
      "executableName": "wan-net",
      "artifactName": "WAN-NET-${version}-${arch}.${ext}",
      "executableArgs": [
        "--no-sandbox"
      ],
      "desktop": {
        "Name": "WAN NET",
        "Comment": "HTTP Tunnel & Request Inspector",
        "Terminal": "false",
        "Categories": "Development;Network;"
      },
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libgbm1",
        "libnss3",
        "libxss1",
        "libasound2"
      ]
    },
    "afterSign": "scripts/notarize.js",
    "publish": {
      "provider": "github",
      "owner": "setiyawan12",
      "repo": "absenku-inspector-request",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@electron/notarize": "^2.3.0"
  }
}
